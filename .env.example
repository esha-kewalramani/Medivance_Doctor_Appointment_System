# ==============================================================================
# MEDIVANCE HEALTHCARE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy the values below into your .env.local file:

# ------------------------------------------------------------------------------
# 1. RESEND (Real Email Delivery)
# ------------------------------------------------------------------------------
# Get your free API key at https://resend.com (Includes 3,000 free emails/month)
RESEND_API_KEY=re_your_resend_api_key_here

# The sender address. For testing, you can use Resend's free verified sandbox:
# "MEDIVANCE Healthcare <onboarding@resend.dev>"
# Once you add your custom hospital domain in Resend, use: "appointments@yourdomain.com"
RESEND_FROM_EMAIL=MEDIVANCE Healthcare <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 2. TWILIO (Real SMS Delivery)
# ------------------------------------------------------------------------------
# Get your credentials at https://www.twilio.com/console
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your Twilio virtual phone number with country code (e.g., +1234567890)
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 3. SUPABASE (Optional - Database & Auth Persistence)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
