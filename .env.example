# Copy this file to .env.local and fill it in. .env.local is never uploaded to Git.
# Leave both public variables empty to run the site in demo mode (LocalStorage, no backend).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# ONLY for `npm run seed:supabase` on your own computer. NEVER prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the deployed site. Used in the links inside password-reset and e-mail-change e-mails.
# Add the same address (plus /reset-password and /email-confirmed) to Supabase -> Authentication -> URL Configuration -> Redirect URLs.
# Leave empty for local development (falls back to the browser address, e.g. http://localhost:3000).
NEXT_PUBLIC_SITE_URL=
